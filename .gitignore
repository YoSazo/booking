# This file tells Git which files to ignore.

# Ignore dependency folders
node_modules/
**/node_modules/

# Ignore all environment files (which contain secret keys)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Ignore build output folders
dist/
build/
.next/
.vercel/

# Ignore system files
.DS_Store
desktop.ini

# Apple signing material belongs in the external signing directory, never Git.
*.p8
*.p12
*.mobileprovision
*.cer
*.keychain-db

# Ignore uploaded images and videos
*.mp4
*.mov
*.avi
guest-lodge-backend/public/uploads/
landing-page/0518.mp4
hotel-booking-app/0518.mp4

# Ignore temp files
.memla_patch_exec_tmp/
temp_server.js

# Ignore internal notes
Conversation about marketel.md
