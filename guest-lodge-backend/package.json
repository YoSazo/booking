{
  "name": "guest-lodge-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser/*.test.js && node test/browser/plans.js",
    "test:browser:prod": "node test/browser/prod-smoke.js",
    "test:browser:review": "node test/browser/review-walk.mjs",
    "wedges:build": "node scripts/wedges-build.js",
    "wedges:check": "node scripts/wedges-build.js --check",
    "qa:release:auto": "npm test && node scripts/release-qa.js",
    "qa:release:database": "node scripts/release-qa.js",
    "stripe:domains:sync": "node scripts/register-stripe-payment-domains.js",
    "start": "npx prisma migrate deploy && node server.js",
    "postinstall": "prisma generate",
    "build:frontdesk": "cd frontdesk && npm install && npm run build",
    "db:push": "dotenv -e .env -- npx prisma db push",
    "db:generate": "dotenv -e .env -- npx prisma generate",
    "wedge:new": "node scripts/wedge-new.js",
    "wedge:check": "node scripts/wedge-check.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.12.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "dotenv-cli": "^10.0.0",
    "express": "^5.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.1",
    "openai": "^7.1.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "stripe": "^18.5.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "playwright-core": "1.27.1",
    "prisma": "^6.19.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
