# Database
DATABASE_URL="postgresql://user:password@localhost:5432/guest_lodge"
DIRECT_URL="postgresql://user:password@localhost:5432/guest_lodge"

# Runtime
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"
SESSION_SECRET="replace-with-a-long-random-secret"
MAGIC_LINK_SECRET="replace-with-a-long-random-secret"
CRM_RETURN_TOKEN_SECRET="replace-with-a-long-random-secret"
# Separate keyed hash secret for Front Desk PINs. Use at least 32 random bytes.
CRM_PIN_HASH_SECRET="replace-with-a-different-long-random-secret"
# Signs 90-day iOS email sessions and one-time login-code hashes.
NATIVE_SESSION_TOKEN_SECRET="replace-with-another-long-random-secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Marketel $199/month subscription billing (separate Stripe account/product)
STRIPE_MARKETEL_SECRET_KEY="sk_test_replace_me"
STRIPE_MARKETEL_PRICE_ID="price_replace_me"
STRIPE_MARKETEL_PRODUCT_ID="prod_replace_me"
STRIPE_MARKETEL_WEBHOOK_SECRET="whsec_replace_me"
BACKEND_URL="http://localhost:3001"

# Optional runtime side-effect controls. Production behavior remains enabled
# unless a value is explicitly set to "false".
ENABLE_FUNNEL_TRACKING="true"
ENABLE_OUTBOUND_EMAIL="true"
ENABLE_VERCEL_PROVISIONING="true"
ENABLE_GUEST_INSTALL_REMINDERS="true"
ENABLE_BOOKING_APPROVAL_SWEEP="true"
ENABLE_BOOKING_REVIEW_REMINDERS="true"
ENABLE_SCHEDULED_PUSH_DIGESTS="true"
ENABLE_ACCOUNT_DELETION_SWEEP="true"

# Internal analytics/admin APIs
ADMIN_TOKEN="replace-with-a-long-random-admin-token"

# Marketel advertising attribution
MARKETEL_META_PIXEL_ID="replace_me"
MARKETEL_META_ACCESS_TOKEN="replace_me"
ENABLE_META_CAPI="true"

# Email
BREVO_API_KEY="replace_me"
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="Guest Lodge"

# Push notifications
VAPID_PUBLIC_KEY="replace_me"
VAPID_PRIVATE_KEY="replace_me"
VAPID_SUBJECT="mailto:support@bookmarketel.com"

# Apple Push Notification service (Marketel Front Desk iOS)
# Generate a .p8 APNs key in the Apple Developer portal. Store the full key in
# APNS_PRIVATE_KEY; escaped "\\n" line breaks are accepted by the server.
APNS_TEAM_ID="replace_me"
APNS_KEY_ID="replace_me"
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID="com.bookmarketel.frontdesk"

# Front Desk Assistant — SMS and natural-language availability updates
ENABLE_FRONTDESK_ASSISTANT="true"
FRONTDESK_ASSISTANT_SECRET="replace-with-a-long-random-secret"
TWILIO_ACCOUNT_SID="AC_replace_me"
TWILIO_AUTH_TOKEN="replace_me"
TWILIO_PHONE_NUMBER="+15555550123"
# Use a Messaging Service instead of TWILIO_PHONE_NUMBER when configured.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_INBOUND_WEBHOOK_URL="https://your-backend.example.com/api/twilio/frontdesk/inbound"
TWILIO_STATUS_CALLBACK_URL="https://your-backend.example.com/api/twilio/frontdesk/status"
TWILIO_VALIDATE_SIGNATURES="true"

# Optional. Without this key, Front Desk still understands exact replies and
# simple messages such as "a walk-in took the Queen Room tonight."
OPENAI_API_KEY="sk_replace_me"
OPENAI_ASSISTANT_MODEL="gpt-5.6-luna"
