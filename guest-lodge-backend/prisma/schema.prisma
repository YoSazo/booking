generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  ourReservationCode    String   @unique
  pmsConfirmationCode   String?
  stripePaymentIntentId String?  @unique
  status                String   @default("confirmed")
  hotelId               String
  roomName              String
  checkinDate           DateTime
  checkoutDate          DateTime
  nights                Int
  guestFirstName        String
  guestLastName         String
  guestEmail            String
  guestPhone            String
  subtotal              Float
  taxesAndFees          Float
  grandTotal            Float
  bookingType           String   @default("standard")

  // Fields for "Pay Later" bookings with pre-auth hold
  amountPaidNow     Float?    @default(0)
  preAuthHoldAmount Float?
  holdStatus        String? // 'active', 'released', 'captured'
  holdReleasedAt    DateTime?
  holdCapturedAt    DateTime?
  noShowFeePaid     Boolean   @default(false)

  // Front desk CRM
  crmStage   String? @default("new")
  callStatus String? @default("not-called")
  notes      String?
  callLog    String? // stored as JSON string

  // Guest PWA adoption
  guestInstallReminderSentAt DateTime?
  guestAppInstalledAt        DateTime?

  // Guestel's delete-conversation action is intentionally one-sided: the
  // property keeps its business record, while the guest no longer downloads
  // messages at or before this point. A later reply starts the thread again.
  guestMessagesHiddenBefore DateTime?
  // Front Desk uses the same one-sided behavior in reverse: removing a thread
  // hides the owner's inbox copy without erasing the reservation or the guest's
  // messages. A later guest reply naturally recreates the conversation.
  ownerMessagesHiddenBefore DateTime?
  guestAccessRevokedAt      DateTime?

  // Owner approval window. While status='pending' the room stays held. The
  // unanswered action is copied onto the booking so changing the property
  // setting never changes a decision that is already counting down.
  approvalRequestedAt      DateTime?
  pendingUntil             DateTime?
  approvalNoResponseAction String? // confirm | release
  approvalOutcome          String? // owner_confirmed | owner_released | auto_confirmed | auto_released | auto_no_alerts
  approvalDecidedAt        DateTime?

  // Owner turned the booking away after it was already confirmed — usually
  // because a walk-in took the room. Frees inventory and voids the card hold.
  cancelledAt        DateTime?
  cancellationReason String?

  // Immediate-confirmation follow-up. Online bookings are confirmed first, then
  // remain visible in Front Desk until the owner verifies room availability.
  ownerReviewStatus         String? // unreviewed | available | cancelled
  ownerReviewRequestedAt    DateTime?
  ownerReviewedAt           DateTime?
  ownerReviewReminderCount  Int       @default(0)
  ownerReviewNextReminderAt DateTime?

  // Manual-availability dates whose explicit remaining-unit counters were
  // decremented by this booking. Stored as a JSON array so cancellation can
  // restore exactly those counters without touching legacy bookings.
  inventoryOverrideDates String?

  // External work triggered by a booking decision must finish even if Render
  // restarts or Stripe/email is briefly unavailable. The aggregate status is
  // shown in Front Desk; individual retryable work lives in sideEffectJobs.
  fulfillmentStatus    String                 @default("none") // none | pending | completed | attention
  fulfillmentLastError String?
  fulfillmentUpdatedAt DateTime?
  sideEffectJobs       BookingSideEffectJob[]

  @@index([status, pendingUntil])
  @@index([hotelId, status, checkinDate])
  @@index([ownerReviewStatus, ownerReviewNextReminderAt])
}

// Durable outbox for guest confirmation/release emails and card-hold actions.
// The unique booking/type pair makes every consequence idempotent at the app
// layer, while Stripe idempotency keys and deterministic email Message-IDs
// protect the provider layer when a worker is interrupted mid-attempt.
model BookingSideEffectJob {
  id            String    @id @default(cuid())
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String
  hotelId       String
  type          String // confirmation_email | release_hold | release_email | cancellation_email
  status        String    @default("pending") // pending | processing | retrying | completed | failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  completedAt   DateTime?
  lastError     String?
  payload       Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([bookingId, type])
  @@index([status, nextAttemptAt])
  @@index([bookingId, status])
  @@index([hotelId, status, updatedAt])
}

model GuestInstallEvent {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  hotelId         String
  reservationCode String?
  touchpoint      String // confirmation-page, frontdesk-qr-guest, confirmation-email, etc.
  eventType       String // view | cta_click | installed
  userAgent       String?

  @@index([hotelId, createdAt])
  @@index([hotelId, eventType, createdAt])
  @@index([reservationCode])
}

// One-use bridge from a web/App Clip confirmation into the full Guestel app.
// Only a hash is stored; the raw value expires after 24 hours and is never a
// reservation capability by itself.
model GuestAppHandoff {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  claimedAt DateTime?
  tokenHash String    @unique
  bookingId String
  hotelId   String

  @@index([expiresAt])
  @@index([bookingId])
}

model PaymentDeclinedLead {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  hotelId          String
  guestFirstName   String
  guestLastName    String
  guestEmail       String
  guestPhone       String
  roomName         String
  checkinDate      String
  checkoutDate     String
  nights           Int
  grandTotal       Float
  errorCode        String?
  errorDeclineCode String?
  errorMessage     String?
  paymentMethod    String? // 'card' | 'wallet'
  called           Boolean  @default(false)
  notes            String?
}

model HitPayment {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  hotelId        String
  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String
  roomName       String
  checkinDate    String
  checkoutDate   String
  nights         Int
  grandTotal     Float
  eventName      String
  eventId        String?
}

model PushSubscription {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  endpoint        String      @unique
  hotel           HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId         String
  p256dh          String
  auth            String
  source          String? // 'funnel' | 'crm' | 'guest'
  reservationCode String?

  @@index([hotelId])
  @@index([hotelId, source])
  @@index([hotelId, reservationCode])
}

// Native App Store devices use APNs rather than browser Web Push. A device may
// subscribe to more than one property so multi-property owners receive every
// booking alert without having to keep switching the app's active property.
model NativePushDevice {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lastSeenAt  DateTime    @default(now())
  hotel       HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId     String
  deviceToken String
  platform    String      @default("ios")
  environment String      @default("production") // production | sandbox
  active      Boolean     @default(true)

  @@unique([deviceToken, hotelId])
  @@index([hotelId, active])
  @@index([deviceToken, active])
}

// Push-to-start token (iOS 17.2+). One per install per property, and it is what
// lets a booking raise a Live Activity while the app is closed — which is the
// entire point, since nobody is holding the phone when a booking lands.
model LiveActivityStarter {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lastSeenAt  DateTime    @default(now())
  hotel       HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId     String
  startToken  String
  environment String      @default("production") // production | sandbox
  active      Boolean     @default(true)

  @@unique([startToken, hotelId])
  @@index([hotelId, active])
}

// A running activity. The update token is issued per activity by ActivityKit,
// so ending the right card requires storing it against the booking that owns it.
model LiveActivity {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  hotel       HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId     String
  bookingId   String
  activityId  String      @unique
  updateToken String
  environment String      @default("production")
  state       String      @default("active") // active | ended
  endedAt     DateTime?

  // At most one live card per booking; a duplicate would strand the first with
  // no token left to end it.
  @@index([bookingId, state])
  @@index([hotelId, state])
}

// Email-code challenges must survive a Render restart and work correctly when
// more than one server instance is handling requests.
model NativeLoginChallenge {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Guestel email verification is separate from Front Desk owner login so a
// guest who also owns a property can request both codes without overwriting one.
model GuestLoginChallenge {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Native Guestel APNs subscriptions are scoped to a verified reservation.
// A device can follow several stays and a stay can be present on several
// devices after email-code recovery.
model GuestNativePushDevice {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastSeenAt      DateTime @default(now())
  deviceToken     String
  environment     String   @default("production")
  hotelId         String
  bookingId       String
  reservationCode String
  stayUpdates     Boolean  @default(true)
  messages        Boolean  @default(true)
  deals           Boolean  @default(false)
  active          Boolean  @default(true)

  @@unique([deviceToken, bookingId])
  @@index([bookingId, active])
  @@index([hotelId, reservationCode, active])
  @@index([deviceToken, active])
}

// A guest can keep a property in Guestel before making a reservation. This
// subscription is deliberately separate from stay-scoped notification access:
// it may receive property updates/direct offers, but it grants no reservation
// or message-thread access.
model GuestelPropertyDevice {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSeenAt     DateTime @default(now())
  deviceToken    String
  environment    String   @default("production")
  hotelId        String
  guestEmailHash String?
  updates        Boolean  @default(true)
  active         Boolean  @default(true)

  @@unique([deviceToken, hotelId])
  @@index([hotelId, active, updates])
  @@index([deviceToken, active])
  @@index([guestEmailHash, active])
}

// A non-reversible email hash is enough to stop old transaction records from
// silently recreating a deleted Guestel wallet. A new booking after deletedAt
// starts a genuinely new guest account without restoring the old history.
model GuestelAccountDeletion {
  emailHash String   @id
  deletedAt DateTime @default(now())
}

model ManualRoom {
  id         String   @id @default(cuid())
  hotelId    String
  name       String
  totalUnits Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  overrides ManualOverride[]

  @@unique([hotelId, name])
}

model ManualOverride {
  id             String     @id @default(cuid())
  room           ManualRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId         String
  date           String
  availableUnits Int?
  closed         Boolean    @default(false)
  updatedAt      DateTime   @updatedAt

  @@unique([roomId, date])
}

model HotelConfig {
  id            String   @id
  name          String?
  pms           String
  propertyId    String?
  siteId        String?
  sitePassword  String?
  chainCode     String?
  roomIDMapping Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Onboarding
  setupToken                   String?   @unique
  setupComplete                Boolean   @default(false)
  // Server-owned recovery state. Browser storage makes the normal path fast,
  // while these fields let an authenticated email link resume on any device.
  setupProgressStep            Int       @default(1)
  revealProgressStep           Int       @default(0)
  setupResumeEmailSentAt       DateTime?
  previewReadyEmailSentAt      DateTime?
  checkoutStartedAt            DateTime?
  checkoutRecoveryEmailSentAt  DateTime?
  subscribed                   Boolean   @default(false)
  stripeAccountId              String?
  marketelStripeCustomerId     String?   @unique
  marketelStripeSubscriptionId String?   @unique
  marketelSubscriptionStatus   String?
  marketelCurrentPeriodEnd     DateTime?
  ownerEmail                   String?
  ownerPhone                   String?

  // Hotel details (editable by owner)
  phone                 String?
  address               String?
  subtitle              String?
  theme                 String? @default("light")
  appIconUrl            String?
  guestelWalletImageUrl String?
  guestelWalletSubtitle String?
  checkInTime           String? @default("15:00")
  checkOutTime          String? @default("11:00")
  cancellationPolicy    String?
  growthChecklist       Json? // owner self-reported "get found" steps: { gbp:{done,ts}, qr:{...}, textLink:{...} }

  // Owner approval: hold new bookings briefly so the owner can catch a room
  // they already sold on an OTA. Useless without push, so it stays off until
  // the owner installs Front Desk and enables alerts.
  bookingApprovalEnabled          Boolean   @default(false)
  bookingApprovalWindowMinutes    Int       @default(20)
  bookingApprovalNoResponseAction String    @default("confirm")
  bookingApprovalPolicyChosenAt   DateTime?
  frontdeskInstalledAt            DateTime?

  // Follow-up reminders for confirmed online bookings. Zero means the first
  // notification only; otherwise Front Desk sends at most three reminders.
  bookingReviewReminderMinutes Int @default(15)

  domains                 HotelDomain[]
  crmPins                 CrmPin[]
  pushSubscriptions       PushSubscription[]
  rooms                   Room[]
  rates                   HotelRates?
  guestMessages           GuestMessage[]
  frontDeskAssistant      FrontDeskAssistantConfig?
  assistantRecipients     FrontDeskAssistantRecipient[]
  assistantActivities     FrontDeskAssistantActivity[]
  assistantPendingActions FrontDeskAssistantPendingAction[]
  nativePushDevices       NativePushDevice[]
  liveActivityStarters    LiveActivityStarter[]
  liveActivities          LiveActivity[]
  accountDeletionRequest  AccountDeletionRequest?
  supportThread           SupportThread?
}

// One durable founder-support conversation per property. Keeping support
// separate from guest messages prevents owner questions from appearing in the
// operational guest inbox while still preserving a complete history.
model SupportThread {
  id                String      @id @default(cuid())
  hotel             HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId           String      @unique
  status            String      @default("open") // open | resolved
  lastMessageAt     DateTime    @default(now())
  ownerLastReadAt   DateTime?
  supportLastReadAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  messages SupportMessage[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  sender    String // owner | support
  body      String
  context   Json?
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

// Account deletion is initiated inside the iOS app, includes a seven-day
// recovery window, and is then completed by the server-side deletion sweep.
model AccountDeletionRequest {
  id               String      @id @default(cuid())
  hotel            HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId          String      @unique
  requestedByEmail String
  requestedAt      DateTime    @default(now())
  scheduledFor     DateTime
  status           String      @default("pending") // pending | processing | failed
  lastError        String?
  updatedAt        DateTime    @updatedAt

  @@index([status, scheduledFor])
}

// Property-side virtual Front Desk. Configuration is one-to-one with a hotel;
// recipients, messages, and reversible actions stay separate so the assistant
// has a complete audit trail without overloading HotelConfig.
model FrontDeskAssistantConfig {
  hotel             HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId           String      @id
  enabled           Boolean     @default(false)
  checkFrequency    String      @default("smart") // smart | 2h | 4h | daily | booking_only | off
  dailyCheckTime    String      @default("18:00")
  quietHoursStart   String?
  quietHoursEnd     String?
  timeZone          String      @default("America/Chicago")
  notifyNewBookings Boolean     @default(true)
  lastCheckAt       DateTime?
  nextCheckAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model FrontDeskAssistantRecipient {
  id                    String      @id @default(cuid())
  hotel                 HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId               String
  name                  String
  role                  String?
  phoneE164             String
  priority              Int         @default(0)
  active                Boolean     @default(true)
  verifiedAt            DateTime?
  consentAt             DateTime?
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int         @default(0)
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  activities     FrontDeskAssistantActivity[]
  pendingActions FrontDeskAssistantPendingAction[]

  @@unique([hotelId, phoneE164])
  @@index([hotelId, active, priority])
  @@index([phoneE164, active])
}

model FrontDeskAssistantActivity {
  id                String                       @id @default(cuid())
  hotel             HotelConfig                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId           String
  recipient         FrontDeskAssistantRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientId       String?
  direction         String // inbound | outbound | system
  type              String // verification | booking_alert | inventory_check | availability_update | help
  body              String?
  summary           String?
  status            String                       @default("recorded") // queued | sent | delivered | failed | recorded
  providerMessageId String?
  metadata          Json?
  createdAt         DateTime                     @default(now())

  @@index([hotelId, createdAt])
  @@index([providerMessageId])
}

model FrontDeskAssistantPendingAction {
  id          String                       @id @default(cuid())
  hotel       HotelConfig                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId     String
  recipient   FrontDeskAssistantRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientId String?
  kind        String // block_availability | confirm_booking | cancel_booking
  payload     Json
  status      String                       @default("pending") // pending | applied | undone | cancelled | expired
  expiresAt   DateTime
  appliedAt   DateTime?
  undoneAt    DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([hotelId, status, expiresAt])
  @@index([recipientId, status, createdAt])
}

// Messages a guest sends to the property from the booking-confirmation screen.
// Surfaces on the Front Desk so owners can act on requests (early check-in,
// late arrival, questions, etc.) without a phone call.
model GuestMessage {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  hotel           HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId         String
  bookingId       String?
  reservationCode String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  roomName        String?
  body            String?
  requests        String? // JSON array of quick-request chip labels
  readAt          DateTime?
  guestReadAt     DateTime?
  sender          String      @default("guest")

  @@index([hotelId, createdAt])
  @@index([hotelId, reservationCode])
}

model Room {
  id           String      @id @default(cuid())
  hotel        HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId      String
  name         String
  description  String?
  amenities    String?
  maxOccupancy Int         @default(4)
  totalUnits   Int         @default(1)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  images RoomImage[]

  @@unique([hotelId, name])
  @@index([hotelId, sortOrder])
}

model RoomImage {
  id        String   @id @default(cuid())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([roomId, sortOrder])
}

model HotelRates {
  id        String      @id @default(cuid())
  hotel     HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId   String      @unique
  nightly   Float       @default(69)
  weekly    Float       @default(299)
  monthly   Float       @default(999)
  taxRate   Float       @default(0.10)
  updatedAt DateTime    @updatedAt
}

model HotelDomain {
  id        String      @id @default(cuid())
  hotel     HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId   String
  domain    String      @unique
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CrmPin {
  id        String      @id @default(cuid())
  hotel     HotelConfig @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId   String
  pinHash   String
  label     String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([hotelId, pinHash])
  @@index([pinHash, active])
}

model FunnelEvent {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  occurredAt     DateTime?
  hotelId        String
  eventName      String
  eventId        String?
  sessionId      String?
  sequence       Int?
  surface        String?
  pagePath       String?
  durationMs     Int?
  metadata       Json?
  value          Float?
  currency       String?   @default("USD")
  contentName    String? // room name
  checkinDate    String?
  checkoutDate   String?
  nights         Int?
  guestFirstName String?
  guestLastName  String?
  guestEmail     String?
  guestPhone     String?
  externalId     String? // cookie-based visitor ID
  userAgent      String?
  ipAddress      String?

  @@index([hotelId, createdAt])
  @@index([eventName, createdAt])
  @@index([externalId, createdAt])
  @@index([sessionId, sequence])
  @@index([hotelId, sessionId, createdAt])
}

// Push for the operator, not for a property. PushSubscription hangs off a
// HotelConfig with a cascade, and the Activity dashboard belongs to no hotel,
// so it needs its own table rather than a sentinel property row invented to
// satisfy a foreign key.
model AdminPushSubscription {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String?
  // Which triggers this device wants. Stored per subscription so a phone and a
  // laptop can differ, and so muting one does not mute the other.
  events     Json?
  lastSentAt DateTime?
  failures   Int       @default(0)
}
